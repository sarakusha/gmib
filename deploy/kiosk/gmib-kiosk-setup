#!/usr/bin/env python3
"""Interactive reference-image setup; enrollment remains owned by tty1's service."""
import contextlib
import fcntl
import ipaddress
import os
from pathlib import Path
import re
import signal
import subprocess
import sys

ROOT = Path('/')
PROVISION = '/usr/local/sbin/gmib-first-boot-provision'
PREPARE = '/usr/local/sbin/gmib-prepare-clone'
SERVICE = 'gmib-provision.service'


def path(name):
    return ROOT / name.lstrip('/')


def command(*args, capture=False):
    return subprocess.run(args, check=True, text=True, timeout=30,
                          stdout=subprocess.PIPE if capture else None).stdout


def admin_user():
    if not path('/etc/gmib/clone.conf').is_file():
        raise RuntimeError('Команда доступна только в образе для клонирования.')
    values = {}
    for line in path('/etc/gmib/setup.conf').read_text().splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        key, separator, value = line.partition('=')
        if not separator or key != 'ADMIN_USER':
            raise RuntimeError('Некорректный /etc/gmib/setup.conf.')
        values[key] = value.strip("\"'")
    user = values.get('ADMIN_USER', '')
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user):
        raise RuntimeError('Некорректное имя администратора в setup.conf.')
    return user


def addresses():
    try:
        output = command('ip', '-4', '-o', 'addr', 'show', 'scope', 'global', capture=True)
    except (OSError, subprocess.SubprocessError):
        return []
    result = []
    for line in output.splitlines():
        words = line.split()
        try:
            address = str(ipaddress.IPv4Interface(words[words.index('inet') + 1]).ip)
        except (ValueError, IndexError):
            continue
        if address not in result:
            result.append(address)
    return result


def preparing():
    # A pending identity is not a usable reference. The transient job check also
    # covers the short interval before preparation writes its durable guard.
    if path('/var/lib/gmib-clone/state.json').exists():
        return True
    try:
        output = command('systemctl', 'show', 'gmib-prepare-clone.service',
                         '--property=ActiveState', '--property=Job', capture=True)
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError('Не удалось проверить состояние подготовки эталона.') from error
    values = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    if not values.get('ActiveState') or 'Job' not in values:
        raise RuntimeError('Не удалось определить состояние подготовки эталона.')
    job = values['Job'].strip()
    return values['ActiveState'] not in ('inactive', 'failed') or job not in ('', '0')


@contextlib.contextmanager
def action_lock(inherit=False):
    fd = os.open(path('/run/gmib-kiosk-setup.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Другая операция настройки уже выполняется.') from None
        if inherit:
            # Keep the lock for the whole shell provisioning process after exec.
            os.set_inheritable(fd, True)
        yield
    finally:
        os.close(fd)


def enroll_on_console(boot):
    with action_lock(inherit=boot):
        if preparing():
            raise RuntimeError('Идёт подготовка эталона. Дождитесь выключения компьютера.')
        if boot:
            os.execv(PROVISION, [PROVISION])
        elif path('/var/lib/gmib-provision/complete').exists():
            print('VPN уже настроен. Повторно вводить код не нужно.')
            return
    if not boot:
        # Starting the service outside the lock allows its --boot process to
        # acquire the same lock before execing enrollment.
        command('systemctl', 'start', SERVICE)
        print('Подключение открыто на экране компьютера. Выберите пункт 1 и введите код там.')


def confirm_prepare(boot, read=input):
    print('\nБудут удалены VPN, активация GMIB и индивидуальные данные устройства.')
    print('Клиентское ПО и публичные SSH-ключи доступа сохранятся.')
    print('После подготовки компьютер выключится. Снимите образ с внешнего носителя,')
    print('не загружая установленную систему. Идентичность своего ПО подготовьте сами.')
    try:
        answer = read('Для подтверждения введите CLONE (латиницей), Enter — отмена: ')
    except (EOFError, KeyboardInterrupt):
        print('Подготовка отменена.')
        return False
    if answer.strip() != 'CLONE':
        print('Подготовка отменена.')
        return False
    if not boot:
        # Do not stop the screen or an existing enrollment until confirmation.
        # Stop completes before we obtain the action lock released by enrollment.
        command('systemctl', 'stop', SERVICE)
    with action_lock():
        if preparing():
            raise RuntimeError('Подготовка уже запущена или не завершена. Проверьте журнал gmib-prepare-clone.service.')
        command(PREPARE, '--poweroff')
    print('Подготовка запущена. Дождитесь выключения; SSH может отключиться.', flush=True)
    return True


def idle_after_eof():
    # The service must not repeatedly restart or erase its display on closed input.
    print('\nВвод закрыт. По SSH доступна команда sudo gmib-kiosk-setup.', flush=True)
    print('Для возврата меню на экран: sudo systemctl restart gmib-provision.service', flush=True)
    while True:
        signal.pause()


def menu(boot, read=input):
    user = admin_user()
    if boot and (path('/var/lib/gmib-clone/personalized.json').is_file() or
                 path('/var/lib/gmib-provision/complete').is_file()):
        # A deployed clone goes straight to code entry; complete also retains the
        # existing enrollment script's interrupted-finish recovery behavior.
        enroll_on_console(True)
        return
    while True:
        print('\nGMIB kiosk — настройка')
        print('Раскладка клавиатуры: US (латиница)')
        ips = addresses()
        if ips:
            print('Подключение по SSH для установки своего ПО:')
            for address in ips:
                print(f'  ssh {user}@{address}')
        else:
            print('IPv4-адрес пока не получен. Проверьте кабель и DHCP.')
        print('Для эталона: установите своё ПО по SSH, затем выберите пункт 2.')
        print('1. Подключить VPN по коду' if boot else
              '1. Открыть подключение VPN на экране компьютера')
        print('2. Подготовить к клонированию и выключить')
        print('R. Обновить IP-адреса')
        if not boot:
            print('0. Выход')
        try:
            choice = read('Выберите пункт: ').strip().lower()
        except EOFError:
            if boot:
                idle_after_eof()
            return
        except KeyboardInterrupt:
            if boot:
                print('\nДля работы выберите пункт меню.')
                continue
            return
        if choice == '0' and not boot:
            return
        try:
            if choice == '1':
                enroll_on_console(boot)
            elif choice == '2':
                if confirm_prepare(boot, read):
                    return
            elif choice != 'r':
                print('Выберите 1, 2 или R.' if boot else 'Выберите 1, 2, R или 0.')
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            print(f'Настройка не выполнена: {error}', file=sys.stderr)


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Запустите команду через sudo: sudo gmib-kiosk-setup')
    if sys.argv[1:] not in ([], ['--boot']):
        raise RuntimeError('Использование: sudo gmib-kiosk-setup')
    menu(sys.argv[1:] == ['--boot'])


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        # Explicit cancellation must not trigger Restart=on-failure.
        sys.exit(0)
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f'GMIB setup: {error}', file=sys.stderr)
        sys.exit(1)
