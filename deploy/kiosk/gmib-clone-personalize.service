[Unit]
Description=Personalize a GMIB kiosk disk clone before network access
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=sysinit.target network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gmib-clone-personalize
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=sysinit.target
